<?xml version="1.0" encoding="utf-8"?>
<!-- Konfiguration der .NET-Framework-Laufzeit für pythonnet / LibreHardwareMonitorLib.
     loadFromRemoteSources: DLLs auch laden, wenn Windows sie als "aus dem Internet" markiert hat
     (passiert beim Entpacken einer heruntergeladenen Zip im Explorer). -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
